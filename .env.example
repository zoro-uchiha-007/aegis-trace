# AEGIS-TRACE Environment Variables Configuration
# Copy this file to .env.local and fill in your keys

# Supabase Database & Authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ipinfo.io REST API Geolocation Token (Server-side only)
IPINFO_TOKEN=your_ipinfo_api_token

# Mapbox Access Token (Optional: MapLibre GL fallback with dark vector tiles will be active if omitted)
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Application-Level Load Balancer ─────────────────────────────────────────
# Set LB_ENABLED=true to activate round-robin load balancing in middleware.ts.
# All /api/* requests will be distributed across the listed backend URLs.
# Requires at least 2 comma-separated URLs in LB_BACKENDS to activate.
# Each request is rewritten to the next backend in the ring (round-robin).
# Diagnostic headers X-LB-Backend and X-LB-Target are added to rewritten responses.
# Falls back to normal routing if disabled, misconfigured, or only 1 backend listed.
#
# Example (two Supabase project replicas):
#   LB_BACKENDS=https://proj1.supabase.co,https://proj2.supabase.co
#
LB_ENABLED=false
LB_BACKENDS=
